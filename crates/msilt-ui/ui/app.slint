// MSI-Toolkit main shell — Windows 11 Fluent Design 2 / WinUI 3 responsive layout.
// Unified Mica topbar + borderless NavigationView rail (WinUI 3 1008px breakpoint)
// + centered fluid max-width containers + natural ScrollView height + floating Toast overlay.

import { Theme } from "theme.slint";
import { Icon, Glyphs } from "icons.slint";
import { AppState, Fmt } from "state.slint";
import { ScrollView } from "std-widgets.slint";
import { NavItem } from "components/nav_item.slint";
import { StatusPill } from "components/status_pill.slint";
import { Banner } from "components/banner.slint";
import { Toast } from "components/toast.slint";
import { HelpPopover } from "components/help_popover.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { PerformancePage } from "pages/performance.slint";
import { DisplayPage } from "pages/display.slint";
import { BatteryPage } from "pages/battery.slint";
import { LightingPage } from "pages/lighting.slint";
import { AutomationPage } from "pages/automation.slint";
import { MonitorPage } from "pages/monitor.slint";
import { SystemPage } from "pages/system.slint";

export { Theme } from "theme.slint";
export { AppState, Fmt } from "state.slint";
export { Glyphs } from "icons.slint";
export { Palette } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "MSI-Toolkit";
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 580px;
    background: Theme.bg;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.font-body;
    forward-focus: keys;

    property <[string]> nav-labels: ["总览", "性能与风扇", "显卡与显示", "电池与电源", "键盘灯效", "自动化", "监控与提示", "系统与工具"];
    property <[string]> nav-glyphs: ["dashboard", "gauge", "display", "battery", "keyboard", "bolt", "pulse", "sliders"];
    // WinUI 3 NavigationView Large breakpoint (1008px); no width animation during resize to avoid full-window layout thrashing.
    property <bool> collapsed: AppState.nav-collapsed || root.width < 1008px;
    property <length> nav-width: collapsed ? Theme.nav-w-collapsed : Theme.nav-w;

    // Mature Win11 Settings / PowerToys reading measures:
    // Settings list pages cap at 1000px; visual workspace pages cap at 1200px (never stretch absurdly on ultrawide).
    property <bool> settings-measure: AppState.page == 2 || AppState.page == 3 || AppState.page == 5 || AppState.page == 7;
    property <length> measure-w: root.settings-measure ? 1000px : 1200px;
    property <bool> sys-oem-expanded: false;
    property <bool> sys-diag-expanded: false;

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape && AppState.help-topic > 0 {
                AppState.command(65, 0, 0);
                return accept;
            }
            if e.modifiers.control {
                if e.text == "1" { AppState.command(10, 0, 0); return accept; }
                if e.text == "2" { AppState.command(10, 1, 0); return accept; }
                if e.text == "3" { AppState.command(10, 2, 0); return accept; }
                if e.text == "4" { AppState.command(10, 3, 0); return accept; }
                if e.text == "5" { AppState.command(10, 4, 0); return accept; }
                if e.text == "6" { AppState.command(10, 5, 0); return accept; }
                if e.text == "7" { AppState.command(10, 6, 0); return accept; }
                if e.text == "8" { AppState.command(10, 7, 0); return accept; }
                if e.text == "b" || e.text == "B" { AppState.command(11, 0, 0); return accept; }
            }
            return reject;
        }
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        spacing: 0px;

        // ── Top status bar (brand aligned with nav column; right-aligned telemetry pills) ─
        Rectangle {
            height: Theme.topbar-h;
            background: Theme.topbar;

            HorizontalLayout {
                padding-left: 0px;
                padding-right: 20px;
                spacing: 0px;

                Rectangle {
                    width: root.nav-width;
                    background: transparent;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            toggle-btn := Rectangle {
                                width: 36px;
                                height: 32px;
                                border-radius: Theme.radius;
                                background: toggle-ta.pressed ? Theme.nav-pressed
                                          : toggle-ta.has-hover ? Theme.nav-hover
                                          : transparent;
                                accessible-role: button;
                                accessible-label: "展开或收起导航";

                                toggle-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppState.command(11, 0, 0); }
                                }

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    glyph: "sidebar";
                                    size: 16px;
                                    tint: Theme.text-2;
                                }
                            }
                        }

                        if !root.collapsed : Text {
                            text: "MSI-Toolkit";
                            font-size: Theme.font-caption;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;

                    if root.width >= 900px : VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: "gauge";
                            value: Fmt.mode-name(AppState.performance-mode);
                        }
                    }
                    if root.width >= 960px : VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: "power";
                            value: AppState.power-source == 0 ? "已接电源" : (AppState.power-source == 1 ? "使用电池" : "电源未知");
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: "thermometer";
                            value: "CPU " + Fmt.celsius(AppState.cpu-temp) + " · GPU " + Fmt.celsius(AppState.gpu-temp);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 1px;
                            height: 14px;
                            background: Theme.divider;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: AppState.connection-level == 3 ? "check" : "info";
                            value: AppState.connection-text;
                            level: AppState.connection-level;
                            clickable: !AppState.demo;
                            clicked => { AppState.command(64, 0, 0); }
                        }
                    }
                }
            }
        }

        // ── Main split: borderless nav rail + LayerFill content workspace ───
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            nav-rail := Rectangle {
                width: root.nav-width;
                background: Theme.nav;
                clip: true;

                property <length> inset: 4px;
                property <length> row-step: 38px;
                property <length> footer-y: max(nav-rail.inset + nav-rail.row-step * 7 + 8px, nav-rail.height - nav-rail.inset - Theme.nav-item-h);

                for i in 7 : NavItem {
                    x: nav-rail.inset;
                    y: nav-rail.inset + nav-rail.row-step * i;
                    width: nav-rail.width - 2 * nav-rail.inset;
                    label: root.nav-labels[i];
                    glyph: root.nav-glyphs[i];
                    selected: AppState.page == i;
                    collapsed: root.collapsed;
                    activated => { AppState.command(10, i, 0); }
                }

                Rectangle {
                    x: 12px;
                    y: nav-rail.footer-y - 6px;
                    width: max(0px, nav-rail.width - 24px);
                    height: 1px;
                    background: Theme.divider;
                }

                NavItem {
                    x: nav-rail.inset;
                    y: nav-rail.footer-y;
                    width: nav-rail.width - 2 * nav-rail.inset;
                    label: root.nav-labels[7];
                    glyph: root.nav-glyphs[7];
                    selected: AppState.page == 7;
                    collapsed: root.collapsed;
                    badge: AppState.update-state == 3 ? "新" : "";
                    activated => { AppState.command(10, 7, 0); }
                }

                // Single floating Win11 3x16 accent selection pill
                Rectangle {
                    x: nav-rail.inset;
                    width: 3px;
                    height: 16px;
                    border-radius: 2px;
                    background: Theme.accent;
                    y: (AppState.page == 7 ? nav-rail.footer-y : (nav-rail.inset + nav-rail.row-step * AppState.page)) + 10px;
                    animate y { duration: Theme.dur-nav; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                }
            }

            workspace := Rectangle {
                horizontal-stretch: 1;
                background: Theme.content;
                clip: true;

                property <length> pad-x: workspace.width >= 900px ? 24px : 16px;
                property <length> header-w: min(max(320px, workspace.width - 2 * workspace.pad-x), root.measure-w);

                // Subtle 1px left + top seam
                Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.content-seam; }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.content-seam; }

                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding-top: 16px;
                    spacing: 12px;

                    // Persistent alert banner (ONLY for actionable blockers; aligned to content measure)
                    if AppState.banner-visible : Rectangle {
                        height: 40px;
                        background: transparent;

                        Banner {
                            x: (parent.width - workspace.header-w) / 2;
                            y: 0px;
                            width: workspace.header-w;
                            level: AppState.banner-level;
                            title: AppState.banner-title;
                            text: AppState.banner-text;
                            action: AppState.banner-action;
                            activate => { AppState.command(61, 0, 0); }
                        }
                    }

                    // Page header aligned cleanly on the exact same vertical axis as cards below
                    Rectangle {
                        height: 30px;
                        background: transparent;

                        HorizontalLayout {
                            x: (parent.width - workspace.header-w) / 2;
                            y: 0px;
                            width: workspace.header-w;
                            height: 30px;
                            spacing: 12px;

                            Text {
                                text: AppState.page-title();
                                font-size: Theme.font-page;
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if AppState.demo : Text {
                                text: "演示模式";
                                color: Theme.text-3;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                            }
                            if AppState.diagnostic : Text {
                                text: "仅查看模式";
                                color: Theme.warn;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Full-width ScrollView so the scrollbar sits cleanly on the window's right edge;
                    // natural preferred-height guarantees zero clipping on any page or window height.
                    scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: scroll.visible-width;
                        content-height: max(scroll.visible-height, page-host.preferred-height);

                        property <length> inner-w: min(max(320px, scroll.visible-width - 2 * workspace.pad-x), root.measure-w);
                        property <length> avail-h: max(360px, scroll.visible-height - 20px);

                        page-host := VerticalLayout {
                            x: (scroll.visible-width - scroll.inner-w) / 2;
                            y: 0px;
                            width: scroll.inner-w;
                            padding-bottom: 20px;
                            alignment: start;

                            if AppState.page == 0 : DashboardPage {
                                width: scroll.inner-w;
                                viewport-h: scroll.avail-h;
                            }
                            if AppState.page == 1 : PerformancePage {
                                width: scroll.inner-w;
                                viewport-h: scroll.avail-h;
                            }
                            if AppState.page == 2 : DisplayPage {
                                width: scroll.inner-w;
                            }
                            if AppState.page == 3 : BatteryPage {
                                width: scroll.inner-w;
                            }
                            if AppState.page == 4 : LightingPage {
                                width: scroll.inner-w;
                            }
                            if AppState.page == 5 : AutomationPage {
                                width: scroll.inner-w;
                            }
                            if AppState.page == 6 : MonitorPage {
                                width: scroll.inner-w;
                                viewport-h: scroll.avail-h;
                            }
                            if AppState.page == 7 : SystemPage {
                                width: scroll.inner-w;
                                oem-expanded <=> root.sys-oem-expanded;
                                diag-expanded <=> root.sys-diag-expanded;
                            }
                        }
                    }
                }

                // ── Floating Help Popover (click-outside / Escape dismiss, zero layout shift) ─
                HelpPopover {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    topic: AppState.help-topic;
                    gpu-oc-range: Fmt.offset-mhz(AppState.gpu-oc-core-min) + " ~ " + Fmt.offset-mhz(AppState.gpu-oc-core-max);
                    saved-modes: AppState.custom-fan-modes-summary;
                    dismiss => { AppState.command(65, 0, 0); }
                }

                // ── Bottom-right floating animated Toast overlay (0px layout shift, never covers headers/actions) ─
                Toast {
                    x: max(workspace.pad-x, workspace.width - self.width - workspace.pad-x);
                    anchor-y: max(12px, workspace.height - self.height - 14px);
                    max-w: min(400px, max(220px, workspace.width - 2 * workspace.pad-x));
                    shown: AppState.toast-visible;
                    level: AppState.toast-level;
                    title: AppState.toast-title;
                    text: AppState.toast-text;
                    dismiss => { AppState.command(62, 0, 0); }
                }
            }
        }
    }
}
