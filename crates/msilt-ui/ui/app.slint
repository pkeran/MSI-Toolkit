// MSI-Toolkit main shell — Windows 11 Fluent Design 2 / Blinue Magpie chrome.
// Unified Mica topbar + borderless NavigationView rail (with floating 3x16
// accent pill) + Magpie centered reading measure on settings pages.

import { Theme } from "theme.slint";
import { Icon, Glyphs } from "icons.slint";
import { AppState, Fmt } from "state.slint";
import { ScrollView } from "std-widgets.slint";
import { NavItem } from "components/nav_item.slint";
import { StatusPill } from "components/status_pill.slint";
import { Banner } from "components/banner.slint";
import { OnboardingOverlay } from "components/onboarding.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { PerformancePage } from "pages/performance.slint";
import { DisplayPage } from "pages/display.slint";
import { BatteryPage } from "pages/battery.slint";
import { LightingPage } from "pages/lighting.slint";
import { AutomationPage } from "pages/automation.slint";
import { MonitorPage } from "pages/monitor.slint";
import { SystemPage } from "pages/system.slint";

export { Theme } from "theme.slint";
export { AppState, Fmt } from "state.slint";
export { Glyphs } from "icons.slint";
export { Palette } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "MSI-Toolkit";
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 960px;
    min-height: 620px;
    background: Theme.bg;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.font-body;
    forward-focus: keys;

    property <[string]> nav-labels: ["总览", "性能与风扇", "显卡与显示", "电池与电源", "键盘灯效", "自动化", "监控与 OSD", "系统与工具"];
    property <[string]> nav-glyphs: ["dashboard", "gauge", "display", "battery", "keyboard", "bolt", "pulse", "sliders"];
    property <bool> collapsed: AppState.nav-collapsed || root.width < 980px;
    property <length> nav-width: collapsed ? Theme.nav-w-collapsed : Theme.nav-w;
    animate nav-width { duration: Theme.dur-nav; easing: cubic-bezier(0, 0, 0, 1); }

    /// Magpie centered 960px reading measure on settings pages (Display/Battery/Automation/System).
    property <bool> settings-measure: AppState.page == 2 || AppState.page == 3 || AppState.page == 5 || AppState.page == 7;
    property <bool> sys-oem-expanded: false;
    property <bool> sys-diag-expanded: false;

    property <length> page-min-h: AppState.page == 0 ? 480px
                                : AppState.page == 1 ? 490px
                                : AppState.page == 2 ? 520px
                                : AppState.page == 3 ? 520px
                                : AppState.page == 4 ? 548px
                                : AppState.page == 5 ? max(460px, 340px + AppState.auto-rules.length * 68px)
                                : AppState.page == 6 ? 480px
                                : (1040px
                                    + AppState.oem-packages.length * 62px
                                    + (root.sys-oem-expanded ? max(52px, AppState.oem-items.length * 44px) : 0px)
                                    + (root.sys-diag-expanded ? 102px : 0px));

    keys := FocusScope {
        key-pressed(e) => {
            if e.modifiers.control {
                if e.text == "1" { AppState.command(10, 0, 0); return accept; }
                if e.text == "2" { AppState.command(10, 1, 0); return accept; }
                if e.text == "3" { AppState.command(10, 2, 0); return accept; }
                if e.text == "4" { AppState.command(10, 3, 0); return accept; }
                if e.text == "5" { AppState.command(10, 4, 0); return accept; }
                if e.text == "6" { AppState.command(10, 5, 0); return accept; }
                if e.text == "7" { AppState.command(10, 6, 0); return accept; }
                if e.text == "8" { AppState.command(10, 7, 0); return accept; }
                if e.text == "b" || e.text == "B" { AppState.command(11, 0, 0); return accept; }
            }
            return reject;
        }
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        spacing: 0px;

        // ── Top status bar (brand locked to nav column; unified telemetry cluster right-aligned) ─
        Rectangle {
            height: Theme.topbar-h;
            background: Theme.topbar;

            HorizontalLayout {
                padding-left: 0px;
                padding-right: 24px;
                spacing: 0px;

                // Left brand slot strictly matched to nav-rail width (never straddles the vertical seam)
                Rectangle {
                    width: root.nav-width;
                    background: transparent;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            toggle-btn := Rectangle {
                                width: 36px;
                                height: 32px;
                                border-radius: Theme.radius;
                                background: toggle-ta.pressed ? Theme.nav-pressed
                                          : toggle-ta.has-hover ? Theme.nav-hover
                                          : transparent;
                                animate background { duration: Theme.dur-hover; easing: ease-out; }
                                accessible-role: button;
                                accessible-label: "展开或收起导航";

                                toggle-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppState.command(11, 0, 0); }
                                }

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    glyph: "sidebar";
                                    size: 16px;
                                    tint: Theme.text-2;
                                }
                            }
                        }

                        if !root.collapsed : Text {
                            text: "MSI-Toolkit";
                            font-size: Theme.font-caption;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }

                // Open negative space above page title (clean Magpie / Win11 Settings breathing room)
                Rectangle { horizontal-stretch: 1; background: transparent; }

                // Unified right-aligned hardware telemetry & daemon status cluster
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: "gauge";
                            value: Fmt.mode-name(AppState.performance-mode);
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: "power";
                            value: AppState.power-source == 0 ? "AC" : (AppState.power-source == 1 ? "DC" : "电源未知");
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: "thermometer";
                            value: "CPU " + Fmt.celsius(AppState.cpu-temp) + " · GPU " + Fmt.celsius(AppState.gpu-temp);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 1px;
                            height: 14px;
                            background: Theme.divider;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            glyph: AppState.connection == 1 ? "check" : "info";
                            value: AppState.connection-text;
                            level: AppState.connection == 1 ? 3 : (AppState.connection == 3 ? 0 : 1);
                        }
                    }
                }
            }
        }

        // ── Main split: borderless nav rail + LayerFill content workspace ───
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            nav-rail := Rectangle {
                width: root.nav-width;
                background: Theme.nav;
                clip: true;

                property <length> inset: 4px;
                property <length> row-step: 38px;
                property <length> footer-y: max(nav-rail.inset + nav-rail.row-step * 7 + 8px, nav-rail.height - nav-rail.inset - Theme.nav-item-h);

                for i in 7 : NavItem {
                    x: nav-rail.inset;
                    y: nav-rail.inset + nav-rail.row-step * i;
                    width: nav-rail.width - 2 * nav-rail.inset;
                    label: root.nav-labels[i];
                    glyph: root.nav-glyphs[i];
                    selected: AppState.page == i;
                    collapsed: root.collapsed;
                    activated => { AppState.command(10, i, 0); }
                }

                Rectangle {
                    x: 12px;
                    y: nav-rail.footer-y - 6px;
                    width: max(0px, nav-rail.width - 24px);
                    height: 1px;
                    background: Theme.divider;
                }

                NavItem {
                    x: nav-rail.inset;
                    y: nav-rail.footer-y;
                    width: nav-rail.width - 2 * nav-rail.inset;
                    label: root.nav-labels[7];
                    glyph: root.nav-glyphs[7];
                    selected: AppState.page == 7;
                    collapsed: root.collapsed;
                    activated => { AppState.command(10, 7, 0); }
                }

                // Single floating Win11 3x16 accent selection pill
                Rectangle {
                    x: nav-rail.inset;
                    width: 3px;
                    height: 16px;
                    border-radius: 2px;
                    background: Theme.accent;
                    y: (AppState.page == 7 ? nav-rail.footer-y : (nav-rail.inset + nav-rail.row-step * AppState.page)) + 10px;
                    animate y { duration: Theme.dur-nav; easing: cubic-bezier(0, 0, 0, 1); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.content;

                // Subtle Magpie 1px left + top dark seam
                Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.content-seam; }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.content-seam; }

                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 14px;

                    if AppState.banner-visible : Banner {
                        level: AppState.banner-level;
                        title: AppState.banner-title;
                        text: AppState.banner-text;
                        action: AppState.banner-action;
                        activate => { AppState.command(61, 0, 0); }
                    }

                    // Clean page header (no redundant descriptive caption)
                    HorizontalLayout {
                        height: 30px;
                        spacing: 12px;
                        Text {
                            text: AppState.page-title();
                            font-size: Theme.font-page;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if AppState.demo : Text {
                            text: "演示";
                            color: Theme.text-3;
                            font-size: Theme.font-caption;
                            vertical-alignment: center;
                        }
                        if AppState.diagnostic : Text {
                            text: "只读管道";
                            color: Theme.warn;
                            font-size: Theme.font-caption;
                            vertical-alignment: center;
                        }
                    }

                    // Scrollable page body (anchored at 0,0; centered 1000px reading measure on settings pages)
                    scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: scroll.visible-width;
                        content-height: max(scroll.visible-height, root.page-min-h);

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: scroll.visible-width;
                            height: max(scroll.visible-height, root.page-min-h);
                            background: transparent;

                            page-frame := Rectangle {
                                property <length> inner-w: root.settings-measure ? min(parent.width, 960px) : parent.width;
                                x: (parent.width - inner-w) / 2;
                                y: 0px;
                                width: inner-w;
                                height: parent.height;
                                background: transparent;

                                if AppState.page == 0 : DashboardPage { width: parent.width; height: parent.height; }
                                if AppState.page == 1 : PerformancePage { width: parent.width; height: parent.height; }
                                if AppState.page == 2 : DisplayPage { width: parent.width; height: parent.height; }
                                if AppState.page == 3 : BatteryPage { width: parent.width; height: parent.height; }
                                if AppState.page == 4 : LightingPage { width: parent.width; height: parent.height; }
                                if AppState.page == 5 : AutomationPage { width: parent.width; height: parent.height; }
                                if AppState.page == 6 : MonitorPage { width: parent.width; height: parent.height; }
                                if AppState.page == 7 : SystemPage {
                                    width: parent.width;
                                    height: parent.height;
                                    oem-expanded <=> root.sys-oem-expanded;
                                    diag-expanded <=> root.sys-diag-expanded;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if AppState.onboarding-open : OnboardingOverlay {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }
}
