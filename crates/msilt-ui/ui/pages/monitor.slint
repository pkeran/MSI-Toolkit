// Page 6: Monitor & Screen Alerts — clamped trend/table height + clean Chinese copy.

import { Theme } from "../theme.slint";
import { AppState, Fmt } from "../state.slint";
import { SpinBox, TabWidget, StandardTableView } from "std-widgets.slint";
import { Sparkline } from "../components/sparkline.slint";
import { SettingsGroup } from "../components/settings_group.slint";
import { SettingsCard } from "../components/settings_card.slint";
import { FluentButton } from "../components/fluent_button.slint";
import { FluentSegmentBar } from "../components/fluent_segment.slint";
import { FluentToggle } from "../components/fluent_toggle.slint";
import { KeyValue, Chip } from "../components/primitives.slint";
import { Icon } from "../icons.slint";

export component MonitorPage inherits Rectangle {
    in property <length> viewport-h: 560px;
    property <length> tab-h: clamp(root.viewport-h - 244px, 236px, 380px);

    VerticalLayout {
        alignment: start;
        spacing: 18px;

        VerticalLayout {
            spacing: Theme.gap-card;

            Rectangle {
                height: 50px;
                background: Theme.card;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.card-stroke;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Icon { glyph: "pulse"; size: 18px; tint: Theme.text-2; }
                    }

                    Text {
                        text: AppState.monitor-paused ? "监控已暂停" : "实时监控";
                        font-size: Theme.font-card-title;
                        color: Theme.text;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        Chip {
                            text: "更新 " + AppState.telemetry-age;
                            level: AppState.monitor-paused ? 1 : 0;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    VerticalLayout {
                        alignment: center;
                        FluentSegmentBar {
                            width: 186px;
                            compact: true;
                            labels: ["1 分", "5 分", "15 分"];
                            values: [1, 5, 15];
                            current: AppState.monitor-window;
                            picked(v) => { AppState.command(71, v, 0); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        FluentButton {
                            text: AppState.monitor-paused ? "继续" : "暂停";
                            variant: 0;
                            compact: true;
                            width: 72px;
                            clicked => { AppState.command(70, 0, 0); }
                        }
                    }
                }
            }

            TabWidget {
                height: root.tab-h;

                Tab {
                    title: "温度趋势";
                    Rectangle {
                        background: Theme.card;
                        border-radius: Theme.radius-card;
                        border-width: 1px;
                        border-color: Theme.card-stroke;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 20px;
                                spacing: 14px;
                                HorizontalLayout {
                                    horizontal-stretch: 0;
                                    spacing: 6px;
                                    VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } }
                                    Text { text: "CPU " + Fmt.celsius(AppState.cpu-temp); font-size: Theme.font-caption; font-family: Theme.font-mono; color: Theme.text-2; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    horizontal-stretch: 0;
                                    spacing: 6px;
                                    VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.warn; } }
                                    Text { text: "GPU " + Fmt.celsius(AppState.gpu-temp); font-size: Theme.font-caption; font-family: Theme.font-mono; color: Theme.text-2; vertical-alignment: center; }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text {
                                    text: "" + AppState.series-len + " 条记录";
                                    font-size: Theme.font-caption;
                                    color: Theme.text-3;
                                    vertical-alignment: center;
                                }
                            }

                            Sparkline {
                                vertical-stretch: 1;
                                cpu-path: AppState.cpu-path;
                                gpu-path: AppState.gpu-path;
                            }

                            HorizontalLayout {
                                height: 24px;
                                spacing: 14px;
                                KeyValue { horizontal-stretch: 1; k: "CPU 风扇"; v: Fmt.rpm(AppState.cpu-rpm); }
                                VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: Theme.divider; } }
                                KeyValue { horizontal-stretch: 1; k: "GPU 风扇"; v: Fmt.rpm(AppState.gpu-rpm); }
                                VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: Theme.divider; } }
                                KeyValue { horizontal-stretch: 1; k: "GPU 功耗"; v: Fmt.watts-pair(AppState.gpu-power-mw, AppState.gpu-power-limit-mw); }
                                VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: Theme.divider; } }
                                KeyValue { horizontal-stretch: 1; k: "内存占用"; v: Fmt.gb-pair(AppState.mem-used-mb, AppState.mem-total-mb); }
                            }
                        }
                    }
                }

                Tab {
                    title: "最近记录";
                    StandardTableView {
                        columns: [
                            { title: "时间" },
                            { title: "CPU °C" },
                            { title: "GPU °C" },
                            { title: "CPU RPM" },
                            { title: "GPU RPM" },
                            { title: "GPU W" }
                        ];
                        rows: AppState.sample-table;
                    }
                }
            }
        }

        SettingsGroup {
            title: "监控与屏幕提示";

            SettingsCard {
                glyph: "pulse";
                title: "独立显卡详细遥测（功耗 / 频率 / 显存）";
                subtitle: AppState.mux-current == 1
                    ? "独显直连模式下自动采集，离开监控页或关闭窗口后自动卸载 NVML"
                    : "混合显卡模式下开启可能会唤醒独立显卡，关闭后自动卸载 NVML";
                card-height: 58px;

                if AppState.mux-current == 1 : Chip {
                    text: "独显直连已自动启用";
                    level: 3;
                }
                if AppState.mux-current != 1 : FluentToggle {
                    checked: AppState.gpu-telemetry;
                    enabled: AppState.interactive;
                    toggled => { AppState.command(90, 0, 0); }
                }
            }

            SettingsCard {
                glyph: "display";
                title: "切换模式时显示悬浮提示";
                card-height: 56px;

                FluentButton {
                    text: "预览提示";
                    glyph: "eye";
                    variant: 2;
                    compact: true;
                    width: 92px;
                    enabled: AppState.interactive;
                    clicked => { AppState.command(95, 0, 0); }
                }
                FluentToggle {
                    checked: AppState.osd-enabled;
                    enabled: AppState.config-known && AppState.interactive;
                    toggled => { AppState.command(91, AppState.osd-enabled ? 0 : 1, 0); }
                }
            }

            SettingsCard {
                glyph: "clock";
                title: "停留时长";
                card-height: 56px;

                SpinBox {
                    width: 128px;
                    value: AppState.osd-duration;
                    minimum: 800;
                    maximum: 5000;
                    step-size: 100;
                    enabled: AppState.config-known && AppState.interactive;
                    edited(v) => { AppState.command(92, v, 0); }
                }
                Text {
                    text: "毫秒";
                    font-size: Theme.font-caption;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
            }
        }
    }
}
