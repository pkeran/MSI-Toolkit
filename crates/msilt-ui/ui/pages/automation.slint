// Page 5: Automation — rule manager with 1-click presets, live dry-run test,
// manual priority controls, and responsive 4-up / 2x2 preset layout.

import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { SettingsGroup } from "../components/settings_group.slint";
import { SettingsCard } from "../components/settings_card.slint";
import { FluentButton } from "../components/fluent_button.slint";
import { FluentToggle } from "../components/fluent_toggle.slint";
import { InfoBar } from "../components/info_bar.slint";
import { Chip } from "../components/primitives.slint";
import { Icon } from "../icons.slint";

export component AutomationPage inherits Rectangle {
    property <bool> wide-presets: root.width >= 700px;

    VerticalLayout {
        alignment: start;
        spacing: Theme.gap-group;

        SettingsGroup {
            title: "自动化开关";

            SettingsCard {
                glyph: "bolt";
                title: "开启自动切换";
                subtitle: "根据插电、电池电量或锁屏状态自动调整性能与屏幕";
                card-height: 60px;

                Text {
                    text: AppState.config-known ? (AppState.automation-enabled ? "已开启" : "已关闭") : "—";
                    font-size: Theme.font-caption;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
                FluentToggle {
                    checked: AppState.automation-enabled;
                    enabled: AppState.config-known && AppState.interactive;
                    toggled => { AppState.command(52, AppState.automation-enabled ? 0 : 1, 0); }
                }
            }

            SettingsCard {
                glyph: "shield";
                title: "手动设置优先";
                subtitle: "你手动改动某项设置后，自动规则会暂时让位";
                card-height: 60px;

                Chip {
                    text: AppState.override-policy;
                    level: 0;
                }
                Chip {
                    text: "已锁定 " + AppState.override-count + " 项";
                    level: AppState.override-count > 0 ? 1 : 0;
                }
                FluentButton {
                    text: "恢复自动";
                    variant: 0;
                    compact: true;
                    width: 88px;
                    enabled: AppState.override-count > 0 && AppState.interactive;
                    clicked => { AppState.command(55, 0, 0); }
                }
            }
        }

        SettingsGroup {
            title: "快捷添加";
            hint: AppState.automation-summary;

            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.card-stroke;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    if root.wide-presets : HorizontalLayout {
                        spacing: 8px;
                        FluentButton { text: "拔电静音 + 60Hz"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 0, 0); } }
                        FluentButton { text: "插电平衡 + 240Hz"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 1, 0); } }
                        FluentButton { text: "低电量超级省电"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 2, 0); } }
                        FluentButton { text: "锁屏熄灭键盘灯"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 3, 0); } }
                    }

                    if !root.wide-presets : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            FluentButton { text: "拔电静音 + 60Hz"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 0, 0); } }
                            FluentButton { text: "插电平衡 + 240Hz"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 1, 0); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            FluentButton { text: "低电量超级省电"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 2, 0); } }
                            FluentButton { text: "锁屏熄灭键盘灯"; glyph: "plus"; variant: 0; horizontal-stretch: 1; enabled: AppState.interactive; clicked => { AppState.command(53, 3, 0); } }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: AppState.dry-run-result;
                            font-size: Theme.font-caption;
                            color: Theme.text-2;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        FluentButton {
                            text: "模拟测试";
                            glyph: "play";
                            variant: 0;
                            compact: true;
                            width: 92px;
                            enabled: AppState.interactive && AppState.auto-rules.length > 0;
                            clicked => { AppState.command(51, 0, 0); }
                        }
                    }
                }
            }
        }

        SettingsGroup {
            title: "当前规则（" + AppState.auto-rules.length + " 条）";

            if AppState.auto-rules.length == 0 : InfoBar {
                level: 0;
                text: "尚未添加规则，点击上方常用模板即可一键创建。";
            }

            for i in AppState.auto-rules.length : Rectangle {
                min-height: 64px;
                background: Theme.card;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: AppState.auto-rules[i].active ? Theme.accent.with-alpha(0.45) : Theme.card-stroke;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 14px;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            glyph: "bolt";
                            size: 18px;
                            tint: AppState.auto-rules[i].enabled ? Theme.accent : Theme.text-disabled;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: AppState.auto-rules[i].name;
                                font-size: Theme.font-card-title;
                                font-weight: 400;
                                color: AppState.auto-rules[i].enabled ? Theme.text : Theme.text-3;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if AppState.auto-rules[i].diagnostic != "" : VerticalLayout {
                                alignment: center;
                                Chip {
                                    text: AppState.auto-rules[i].diagnostic;
                                    level: AppState.auto-rules[i].active ? 3 : 0;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }

                        Text {
                            text: AppState.auto-rules[i].trigger + "  →  " + AppState.auto-rules[i].actions;
                            font-size: Theme.font-caption;
                            color: Theme.text-2;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        FluentToggle {
                            checked: AppState.auto-rules[i].enabled;
                            enabled: AppState.interactive;
                            toggled => {
                                AppState.command(50, i, AppState.auto-rules[i].enabled ? 0 : 1);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        FluentButton {
                            glyph: "trash";
                            variant: 2;
                            compact: true;
                            width: 32px;
                            enabled: AppState.interactive;
                            clicked => { AppState.command(54, i, 0); }
                        }
                    }
                }
            }
        }
    }
}
