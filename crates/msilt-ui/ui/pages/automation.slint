// Page 5: Automation — complete rule manager wired to daemon automation.toml
// hot-reload, 1-click LLT-style presets, live dry-run diagnostics, and manual override release.

import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { Switch } from "std-widgets.slint";
import { SettingsGroup } from "../components/settings_group.slint";
import { SettingsCard } from "../components/settings_card.slint";
import { FluentButton } from "../components/fluent_button.slint";
import { InfoBar } from "../components/info_bar.slint";
import { Chip } from "../components/primitives.slint";
import { Icon } from "../icons.slint";

export component AutomationPage inherits Rectangle {
    VerticalLayout {
        alignment: start;
        spacing: Theme.gap-group;

        // ── Group 1: Engine & Manual Override ───────────────────────────────
        SettingsGroup {
            title: "引擎与控制权";

            SettingsCard {
                glyph: "bolt";
                title: "启用自动化引擎";
                card-height: 58px;

                Text {
                    text: AppState.config-known ? (AppState.automation-enabled ? "已开启" : "已关闭") : "—";
                    font-size: Theme.font-caption;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
                Switch {
                    checked: AppState.automation-enabled;
                    enabled: AppState.config-known && AppState.interactive;
                    toggled => { AppState.command(52, AppState.automation-enabled ? 0 : 1, 0); }
                }
            }

            SettingsCard {
                glyph: "shield";
                title: "人工控制优先权";
                card-height: 58px;

                Chip {
                    text: AppState.override-policy;
                    level: 0;
                }
                Chip {
                    text: "占用 " + AppState.override-count + " 项";
                    level: AppState.override-count > 0 ? 1 : 0;
                }
                FluentButton {
                    text: "释放占用";
                    variant: 0;
                    compact: true;
                    width: 96px;
                    enabled: AppState.override-count > 0 && AppState.interactive;
                    clicked => { AppState.command(55, 0, 0); }
                }
            }
        }

        // ── Group 2: Quick Presets & Dry-Run ────────────────────────────────
        SettingsGroup {
            title: "快捷添加";
            hint: AppState.automation-summary;

            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.card-stroke;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        FluentButton {
                            text: "拔电静音 + 60Hz";
                            glyph: "plus";
                            variant: 0;
                            horizontal-stretch: 1;
                            enabled: AppState.interactive;
                            clicked => { AppState.command(53, 0, 0); }
                        }
                        FluentButton {
                            text: "插电平衡 + 240Hz";
                            glyph: "plus";
                            variant: 0;
                            horizontal-stretch: 1;
                            enabled: AppState.interactive;
                            clicked => { AppState.command(53, 1, 0); }
                        }
                        FluentButton {
                            text: "低电量超级省电";
                            glyph: "plus";
                            variant: 0;
                            horizontal-stretch: 1;
                            enabled: AppState.interactive;
                            clicked => { AppState.command(53, 2, 0); }
                        }
                        FluentButton {
                            text: "锁屏熄灭键盘灯";
                            glyph: "plus";
                            variant: 0;
                            horizontal-stretch: 1;
                            enabled: AppState.interactive;
                            clicked => { AppState.command(53, 3, 0); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: AppState.dry-run-result;
                            font-size: Theme.font-caption;
                            color: Theme.text-2;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        FluentButton {
                            text: "试跑诊断";
                            glyph: "play";
                            variant: 0;
                            compact: true;
                            width: 96px;
                            enabled: AppState.interactive && AppState.auto-rules.length > 0;
                            clicked => { AppState.command(51, 0, 0); }
                        }
                    }
                }
            }
        }

        // ── Group 3: Active Rules Stack ─────────────────────────────────────
        SettingsGroup {
            title: "当前规则列表（" + AppState.auto-rules.length + " 条）";

            if AppState.auto-rules.length == 0 : InfoBar {
                level: 0;
                text: "尚未添加自动化规则。可点击上方快捷模板一键创建，或编辑 %LOCALAPPDATA%\\MSI-Toolkit\\automation.toml。";
            }

            for i in AppState.auto-rules.length : Rectangle {
                min-height: 66px;
                background: Theme.card;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: AppState.auto-rules[i].active ? Theme.accent.with-alpha(0.45) : Theme.card-stroke;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 14px;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            glyph: "bolt";
                            size: 18px;
                            tint: AppState.auto-rules[i].enabled ? Theme.accent : Theme.text-disabled;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: AppState.auto-rules[i].name;
                                font-size: Theme.font-card-title;
                                font-weight: 400;
                                color: AppState.auto-rules[i].enabled ? Theme.text : Theme.text-3;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                Chip {
                                    text: "P" + AppState.auto-rules[i].priority;
                                    level: 0;
                                }
                            }
                            if AppState.auto-rules[i].diagnostic != "" : VerticalLayout {
                                alignment: center;
                                Chip {
                                    text: AppState.auto-rules[i].diagnostic;
                                    level: AppState.auto-rules[i].active ? 3 : 0;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }

                        Text {
                            text: AppState.auto-rules[i].trigger + "  →  " + AppState.auto-rules[i].actions;
                            font-size: Theme.font-caption;
                            color: Theme.text-2;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: AppState.auto-rules[i].enabled;
                            enabled: AppState.interactive;
                            toggled => {
                                AppState.command(50, i, AppState.auto-rules[i].enabled ? 0 : 1);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        FluentButton {
                            glyph: "trash";
                            variant: 2;
                            compact: true;
                            width: 32px;
                            enabled: AppState.interactive;
                            clicked => { AppState.command(54, i, 0); }
                        }
                    }
                }
            }
        }
    }
}
