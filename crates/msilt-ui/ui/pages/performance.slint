// Page 1: Performance & Fans — unified 2-tier thermal cockpit:
//   Tier 1: Performance Mode (power envelope) + Cooler Boost (emergency full-speed)
//   Tier 2: Unified Fan Strategy (主板自动 | 自定义曲线) + dual-channel presets + single Apply/Undo
//   Tier 3: GPU Clock Offset (NVML P0 safe envelope) with floating `?` help popover

import { Theme } from "../theme.slint";
import { AppState, Fmt } from "../state.slint";
import { Slider } from "std-widgets.slint";
import { SettingsCard } from "../components/settings_card.slint";
import { FluentButton } from "../components/fluent_button.slint";
import { FluentSegmentBar } from "../components/fluent_segment.slint";
import { FluentToggle } from "../components/fluent_toggle.slint";
import { FanCurveEditor } from "../components/fan_curve.slint";
import { InfoBar } from "../components/info_bar.slint";
import { HelpIconButton } from "../components/help_popover.slint";
import { Chip, Rule } from "../components/primitives.slint";

component ModeCard inherits Rectangle {
    horizontal-stretch: 3;
    height: 62px;
    background: transparent;

    pure function mode-subtitle() -> string {
        if AppState.cooler-boost { return "强冷散热全速接管中"; }
        if AppState.performance-mode == 3 { return "解锁 175W 满血按需释放 · 高性能优先"; }
        if AppState.performance-mode == 2 { return "平衡功耗与噪音 · 日常推荐"; }
        if AppState.performance-mode == 1 { return "低噪节能 · 主板内置静音风扇"; }
        if AppState.performance-mode == 0 { return "限制约 95W · 续航优先"; }
        return "";
    }

    SettingsCard {
        card-height: 62px;
        glyph: "gauge";
        title: "性能模式";
        subtitle: root.mode-subtitle();

        FluentSegmentBar {
            width: 288px;
            compact: true;
            labels: AppState.mode-labels.length > 0 ? AppState.mode-labels : ["省电", "静音", "平衡", "极致"];
            values: [0, 1, 2, 3];
            current: AppState.mode-choice;
            enabled: AppState.cap-performance && AppState.interactive && AppState.mode-labels.length > 0;
            picked(i) => { AppState.command(20, i, 0); }
        }
    }
}

component CoolerCard inherits Rectangle {
    horizontal-stretch: 2;
    height: 62px;
    background: transparent;

    SettingsCard {
        card-height: 62px;
        glyph: "pulse";
        title: "强冷散热";
        subtitle: AppState.cooler-boost ? "双风扇全速运行中" : "双风扇一键全速排热";
        accent-border: AppState.cooler-boost ? Theme.warn : transparent;

        FluentToggle {
            checked: AppState.cooler-boost;
            enabled: AppState.cap-cooler && AppState.cooler-boost-known && AppState.interactive;
            toggled => { AppState.command(21, AppState.cooler-boost ? 0 : 1, 0); }
        }
    }
}

component CpuCurveCard inherits Rectangle {
    in property <length> canvas-h: 196px;
    horizontal-stretch: 1;
    background: transparent;

    FanCurveEditor {
        title: "CPU 风扇";
        channel: 0;
        canvas-height: root.canvas-h;
        points: AppState.cpu-curve;
        max-duty: AppState.cpu-curve-max;
        live-temp: AppState.cpu-temp;
        live-rpm: AppState.cpu-rpm;
        live-duty: AppState.cpu-duty;
        readonly: !AppState.cpu-curve-editable;
        custom-active: !AppState.cooler-boost && AppState.fan-mode == 2;
        pending: AppState.curve-apply-pending;
        dirty: AppState.cpu-curve-dirty;
        error: AppState.curve-channel == 0 ? AppState.curve-error : "";
        edit(i, d) => { AppState.curve-edit(0, i, d); }
    }
}

component GpuCurveCard inherits Rectangle {
    in property <length> canvas-h: 196px;
    horizontal-stretch: 1;
    background: transparent;

    FanCurveEditor {
        title: "GPU 风扇";
        channel: 1;
        canvas-height: root.canvas-h;
        points: AppState.gpu-curve;
        max-duty: AppState.gpu-curve-max;
        live-temp: AppState.gpu-temp;
        live-rpm: AppState.gpu-rpm;
        live-duty: AppState.gpu-duty;
        readonly: !AppState.gpu-curve-editable;
        custom-active: !AppState.cooler-boost && AppState.fan-mode == 2;
        pending: AppState.curve-apply-pending;
        dirty: AppState.gpu-curve-dirty;
        error: AppState.curve-channel == 1 ? AppState.curve-error : "";
        edit(i, d) => { AppState.curve-edit(1, i, d); }
    }
}

component OffsetRow inherits Rectangle {
    in property <string> label: "";
    in property <string> live-clock: "—";
    in property <int> value: 0;
    in property <int> min-val: 0;
    in property <int> max-val: 200;
    in property <bool> enabled: true;
    callback edited(v: int);

    height: 36px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;

        Text {
            width: 96px;
            text: root.label;
            font-size: Theme.font-body;
            color: Theme.text;
            vertical-alignment: center;
        }

        FluentButton {
            text: "−";
            compact: true;
            variant: 2;
            width: 30px;
            enabled: root.enabled && root.value > root.min-val;
            clicked => { root.edited(max(root.min-val, root.value - 5)); }
        }

        Slider {
            horizontal-stretch: 1;
            minimum: root.min-val;
            maximum: root.max-val;
            step: 5;
            value: root.value;
            enabled: root.enabled;
            changed(v) => { root.edited(Math.round(v / 5.0) * 5); }
        }

        FluentButton {
            text: "+";
            compact: true;
            variant: 2;
            width: 30px;
            enabled: root.enabled && root.value < root.max-val;
            clicked => { root.edited(min(root.max-val, root.value + 5)); }
        }

        Text {
            width: 72px;
            text: Fmt.offset-mhz(root.value);
            font-size: Theme.font-body;
            font-weight: 600;
            font-family: Theme.font-mono;
            color: root.value != 0 ? Theme.accent : Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            width: 112px;
            text: "当前 " + root.live-clock;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            color: Theme.text-3;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component GpuOffsetSection inherits VerticalLayout {
    spacing: Theme.gap-group-head;

    property <bool> on-ac: AppState.power-source == 0;
    property <bool> can-apply-oc: AppState.cap-gpu-oc && AppState.interactive && (root.on-ac || (AppState.gpu-oc-draft-core == 0 && AppState.gpu-oc-draft-mem == 0));
    property <bool> can-reset-oc: AppState.cap-gpu-oc && AppState.interactive && (AppState.gpu-oc-active || AppState.gpu-oc-dirty);

    HorizontalLayout {
        spacing: 8px;
        height: 28px;

        Text {
            text: "显卡频率偏移（进阶）";
            font-size: Theme.font-group;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            HelpIconButton {
                active: AppState.help-topic == 2;
                label: "查看显卡频率偏移安全说明";
                clicked => { AppState.command(65, 2, 0); }
            }
        }
        VerticalLayout {
            alignment: center;
            Chip {
                text: AppState.gpu-oc-active
                    ? ("已生效 · " + Fmt.offset-mhz(AppState.gpu-oc-core) + " / " + Fmt.offset-mhz(AppState.gpu-oc-mem))
                    : (!root.on-ac ? "仅插电可应用" : "默认 0 MHz");
                level: AppState.gpu-oc-active ? 3 : (!root.on-ac ? 1 : 0);
            }
        }
        if AppState.gpu-oc-dirty : VerticalLayout {
            alignment: center;
            Chip {
                text: "未应用";
                level: 1;
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }

        Text {
            text: "开机恢复";
            font-size: Theme.font-caption;
            color: Theme.text-2;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            FluentToggle {
                checked: AppState.gpu-oc-restore-boot;
                enabled: AppState.interactive && (AppState.config-known || AppState.demo);
                toggled => { AppState.command(39, AppState.gpu-oc-restore-boot ? 0 : 1, 0); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle { width: 1px; height: 14px; background: Theme.divider; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            FluentButton {
                text: "重置 0 MHz";
                compact: true;
                variant: 0;
                width: 88px;
                enabled: root.can-reset-oc;
                clicked => { AppState.command(38, 0, 0); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            FluentButton {
                text: "应用偏移";
                compact: true;
                variant: 1;
                width: 84px;
                enabled: root.can-apply-oc && AppState.gpu-oc-dirty;
                clicked => { AppState.command(37, 0, 0); }
            }
        }
    }

    Rectangle {
        background: Theme.card;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.card-stroke;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            OffsetRow {
                label: "核心频率偏移";
                live-clock: Fmt.mhz(AppState.gpu-clock-mhz);
                value: AppState.gpu-oc-draft-core;
                min-val: AppState.gpu-oc-core-min;
                max-val: AppState.gpu-oc-core-max;
                enabled: AppState.cap-gpu-oc && AppState.interactive && root.on-ac;
                edited(v) => { AppState.command(35, v, 0); }
            }

            Rule { }

            OffsetRow {
                label: "显存频率偏移";
                live-clock: Fmt.mhz(AppState.gpu-mem-clock-mhz);
                value: AppState.gpu-oc-draft-mem;
                min-val: AppState.gpu-oc-mem-min;
                max-val: AppState.gpu-oc-mem-max;
                enabled: AppState.cap-gpu-oc && AppState.interactive && root.on-ac;
                edited(v) => { AppState.command(36, v, 0); }
            }
        }
    }
}

component FanPresetAndCommitBar inherits HorizontalLayout {
    in property <bool> can-apply: false;
    spacing: 6px;
    height: 30px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        FluentButton {
            text: "静音底线";
            compact: true;
            variant: 2;
            width: 68px;
            enabled: !AppState.curve-apply-pending && (AppState.cpu-curve-editable || AppState.gpu-curve-editable);
            clicked => { AppState.command(33, 0, 0); }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        FluentButton {
            text: "按需均衡";
            compact: true;
            variant: 2;
            width: 68px;
            enabled: !AppState.curve-apply-pending && (AppState.cpu-curve-editable || AppState.gpu-curve-editable);
            clicked => { AppState.command(33, 1, 0); }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        FluentButton {
            text: "极限散热";
            compact: true;
            variant: 2;
            width: 68px;
            enabled: !AppState.curve-apply-pending && (AppState.cpu-curve-editable || AppState.gpu-curve-editable);
            clicked => { AppState.command(33, 2, 0); }
        }
    }

    if AppState.curve-dirty || AppState.curve-apply-pending : VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        Rectangle { width: 1px; height: 14px; background: Theme.divider; }
    }
    if AppState.curve-dirty || AppState.curve-apply-pending : VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        FluentButton {
            text: "撤销";
            compact: true;
            variant: 0;
            width: 54px;
            enabled: !AppState.curve-apply-pending && AppState.curve-dirty;
            clicked => { AppState.command(32, -1, 0); }
        }
    }
    if AppState.curve-dirty || AppState.curve-apply-pending : VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        FluentButton {
            text: AppState.curve-apply-pending ? "应用中" : "保存曲线";
            compact: true;
            variant: 1;
            width: 78px;
            enabled: root.can-apply && !AppState.curve-apply-pending && AppState.curve-dirty && AppState.curve-error == "";
            clicked => { AppState.command(31, -1, 0); }
        }
    }
}

export component PerformancePage inherits Rectangle {
    in property <length> viewport-h: 560px;
    background: transparent;
    horizontal-stretch: 1;

    property <bool> wide-top: root.width >= 760px;
    property <bool> wide-curves: root.width >= 880px;
    property <bool> wide-toolbar: root.width >= 820px;
    property <bool> silent-mode: AppState.performance-mode == 1;
    property <bool> custom-active: !AppState.cooler-boost && AppState.fan-mode == 2;
    property <bool> can-apply-fan: AppState.cap-fan && AppState.ec-writable && !AppState.cooler-boost && !root.silent-mode && AppState.interactive;
    property <int> fan-strategy-idx: AppState.cooler-boost || root.silent-mode ? -1 : (AppState.fan-mode == 2 ? 1 : 0);
    property <length> curve-canvas-h: root.wide-curves
        ? clamp(root.viewport-h - 210px, 212px, 286px)
        : 224px;

    VerticalLayout {
        alignment: start;
        spacing: 14px;

        if root.wide-top : HorizontalLayout {
            spacing: Theme.gap;
            height: 62px;
            ModeCard { }
            CoolerCard { }
        }
        if !root.wide-top : VerticalLayout {
            spacing: Theme.gap-card;
            ModeCard { }
            CoolerCard { }
        }

        // ── Tier 2: Unified Fan Strategy + Dual-Channel Curves ──────────────
        VerticalLayout {
            spacing: Theme.gap-group-head;

            HorizontalLayout {
                spacing: 8px;
                height: 30px;

                Text {
                    text: "风扇曲线";
                    font-size: Theme.font-group;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    HelpIconButton {
                        active: AppState.help-topic == 1;
                        label: "查看风扇曲线与红蓝区域说明";
                        clicked => { AppState.command(65, 1, 0); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FluentSegmentBar {
                        width: 172px;
                        compact: true;
                        labels: ["主板自动", "自定义曲线"];
                        values: [0, 1];
                        current: root.fan-strategy-idx;
                        enabled: root.can-apply-fan && !AppState.curve-apply-pending;
                        picked(v) => {
                            if v == 0 && AppState.fan-mode == 2 {
                                AppState.command(34, 0, 0);
                            } else if v == 1 && (AppState.fan-mode != 2 || AppState.curve-dirty) {
                                AppState.command(31, -1, 0);
                            }
                        }
                    }
                }
                if !AppState.cooler-boost && !root.silent-mode && AppState.current-mode-custom-saved && !AppState.curve-dirty : VerticalLayout {
                    alignment: center;
                    Chip {
                        text: "已记忆 · " + Fmt.mode-name(AppState.performance-mode);
                        level: 3;
                    }
                }
                if AppState.curve-dirty : VerticalLayout {
                    alignment: center;
                    Chip {
                        text: "未保存";
                        level: 1;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                if root.wide-toolbar : FanPresetAndCommitBar {
                    can-apply: root.can-apply-fan;
                }
            }

            if !root.wide-toolbar : HorizontalLayout {
                height: 30px;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FanPresetAndCommitBar {
                    can-apply: root.can-apply-fan;
                }
            }

            // Active hardware blockers ONLY (zero permanent chatter in normal state)
            if AppState.cooler-boost : InfoBar {
                level: 4;
                text: "强冷散热已开启，双风扇当前由硬件全速接管，关闭后将自动恢复当前模式的风扇策略。";
            }
            if !AppState.cooler-boost && root.silent-mode : InfoBar {
                level: 4;
                text: "静音模式由主板内置静音风扇接管；如需自定义曲线，请切换至平衡、极致性能或超级省电模式。";
            }

            if root.wide-curves : HorizontalLayout {
                spacing: Theme.gap;
                CpuCurveCard { canvas-h: root.curve-canvas-h; }
                GpuCurveCard { canvas-h: root.curve-canvas-h; }
            }
            if !root.wide-curves : VerticalLayout {
                spacing: Theme.gap;
                CpuCurveCard { canvas-h: root.curve-canvas-h; }
                GpuCurveCard { canvas-h: root.curve-canvas-h; }
            }
        }

        if AppState.gpu-oc-supported : GpuOffsetSection { }
    }
}
