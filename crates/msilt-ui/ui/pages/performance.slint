// Page 1: Performance & Fans — smooth sliding mode selector + 强冷散热 +
// responsive dual 6-knot fan curves (side-by-side on wide windows, stacked on half-screen snap).

import { Theme } from "../theme.slint";
import { AppState, Fmt } from "../state.slint";
import { SettingsCard } from "../components/settings_card.slint";
import { FluentButton } from "../components/fluent_button.slint";
import { FluentSegmentBar } from "../components/fluent_segment.slint";
import { FluentToggle } from "../components/fluent_toggle.slint";
import { FanCurveEditor } from "../components/fan_curve.slint";
import { InfoBar } from "../components/info_bar.slint";
import { Chip, NoteRow } from "../components/primitives.slint";

component ModeCard inherits Rectangle {
    horizontal-stretch: 3;
    height: 62px;
    background: transparent;

    SettingsCard {
        card-height: 62px;
        glyph: "gauge";
        title: "性能模式";
        subtitle: AppState.cooler-boost ? "强冷散热接管中"
                : AppState.fan-mode == 2 ? "当前使用自定义风扇曲线"
                : AppState.fan-mode == 1 ? "当前使用主板静音策略"
                : AppState.fan-mode == 0 ? "当前使用主板自动策略"
                : "";

        FluentSegmentBar {
            width: 288px;
            compact: true;
            labels: AppState.mode-labels.length > 0 ? AppState.mode-labels : ["省电", "静音", "平衡", "极致"];
            values: [0, 1, 2, 3];
            current: AppState.mode-choice;
            enabled: AppState.cap-performance && AppState.interactive && AppState.mode-labels.length > 0;
            picked(i) => { AppState.command(20, i, 0); }
        }
    }
}

component CoolerCard inherits Rectangle {
    horizontal-stretch: 2;
    height: 62px;
    background: transparent;

    SettingsCard {
        card-height: 62px;
        glyph: "pulse";
        title: "强冷散热";
        subtitle: AppState.cooler-boost ? "风扇全速运行中" : "风扇全速运转";
        accent-border: AppState.cooler-boost ? Theme.warn : transparent;

        FluentToggle {
            checked: AppState.cooler-boost;
            enabled: AppState.cap-cooler && AppState.cooler-boost-known && AppState.interactive;
            toggled => { AppState.command(21, AppState.cooler-boost ? 0 : 1, 0); }
        }
    }
}

component CpuCurveCard inherits Rectangle {
    in property <length> canvas-h: 196px;
    horizontal-stretch: 1;
    background: transparent;

    FanCurveEditor {
        title: "CPU 风扇";
        channel: 0;
        canvas-height: root.canvas-h;
        points: AppState.cpu-curve;
        max-duty: AppState.cpu-curve-max;
        live-temp: AppState.cpu-temp;
        live-rpm: AppState.cpu-rpm;
        live-duty: AppState.cpu-duty;
        readonly: !AppState.cpu-curve-editable;
        can-apply: AppState.cap-fan && AppState.ec-writable && !AppState.cooler-boost && AppState.performance-mode != 1 && AppState.interactive;
        custom-active: !AppState.cooler-boost && AppState.fan-mode == 2;
        blocked-by-mode: AppState.cooler-boost || AppState.performance-mode == 1;
        pending: AppState.curve-apply-pending;
        dirty: AppState.cpu-curve-dirty;
        error: AppState.curve-channel == 0 ? AppState.curve-error : "";
        edit(i, d) => { AppState.curve-edit(0, i, d); }
        apply() => { AppState.command(31, 0, 0); }
        reset() => { AppState.command(32, 0, 0); }
    }
}

component GpuCurveCard inherits Rectangle {
    in property <length> canvas-h: 196px;
    horizontal-stretch: 1;
    background: transparent;

    FanCurveEditor {
        title: "GPU 风扇";
        channel: 1;
        canvas-height: root.canvas-h;
        points: AppState.gpu-curve;
        max-duty: AppState.gpu-curve-max;
        live-temp: AppState.gpu-temp;
        live-rpm: AppState.gpu-rpm;
        live-duty: AppState.gpu-duty;
        readonly: !AppState.gpu-curve-editable;
        can-apply: AppState.cap-fan && AppState.ec-writable && !AppState.cooler-boost && AppState.performance-mode != 1 && AppState.interactive;
        custom-active: !AppState.cooler-boost && AppState.fan-mode == 2;
        blocked-by-mode: AppState.cooler-boost || AppState.performance-mode == 1;
        pending: AppState.curve-apply-pending;
        dirty: AppState.gpu-curve-dirty;
        error: AppState.curve-channel == 1 ? AppState.curve-error : "";
        edit(i, d) => { AppState.curve-edit(1, i, d); }
        apply() => { AppState.command(31, 1, 0); }
        reset() => { AppState.command(32, 1, 0); }
    }
}

export component PerformancePage inherits Rectangle {
    in property <length> viewport-h: 560px;
    background: transparent;
    horizontal-stretch: 1;

    property <bool> wide-top: root.width >= 760px;
    property <bool> wide-curves: root.width >= 780px;
    property <bool> silent-mode: AppState.performance-mode == 1;
    property <bool> show-restore-auto: !AppState.cooler-boost && !root.silent-mode && (AppState.fan-mode == 2 || AppState.current-mode-custom-saved);
    property <length> curve-canvas-h: root.wide-curves
        ? clamp(root.viewport-h - 266px, 184px, 274px)
        : 204px;

    VerticalLayout {
        alignment: start;
        spacing: 14px;

        if root.wide-top : HorizontalLayout {
            spacing: Theme.gap;
            height: 62px;
            ModeCard { }
            CoolerCard { }
        }
        if !root.wide-top : VerticalLayout {
            spacing: Theme.gap-card;
            ModeCard { }
            CoolerCard { }
        }

        VerticalLayout {
            spacing: Theme.gap-group-head;

            HorizontalLayout {
                spacing: 6px;
                height: 30px;

                Text {
                    text: "风扇曲线";
                    font-size: Theme.font-group;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Chip {
                        text: AppState.cooler-boost ? "强冷全速中"
                            : AppState.fan-mode == 2 ? "自定义曲线生效中"
                            : AppState.fan-mode == 1 ? "静音策略"
                            : AppState.fan-mode == 0 ? (root.width < 880px ? "自动策略" : ("自动策略 · " + Fmt.mode-name(AppState.performance-mode)))
                            : "策略未知";
                        level: AppState.cooler-boost ? 1
                             : AppState.fan-mode == 2 ? 3
                             : (AppState.fan-mode == 0 || AppState.fan-mode == 1) ? 4
                             : 0;
                    }
                }
                if AppState.curve-dirty : VerticalLayout {
                    alignment: center;
                    Chip {
                        text: "未保存";
                        level: 1;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }

                if root.show-restore-auto : VerticalLayout {
                    alignment: center;
                    FluentButton {
                        text: "恢复自动";
                        compact: true;
                        variant: 0;
                        width: 76px;
                        enabled: AppState.cap-fan && AppState.ec-writable && AppState.interactive && !AppState.curve-apply-pending;
                        clicked => { AppState.command(34, 0, 0); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FluentButton {
                        text: "出厂";
                        compact: true;
                        variant: 2;
                        width: 56px;
                        enabled: !AppState.curve-apply-pending;
                        clicked => { AppState.command(33, AppState.curve-channel, 0); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FluentButton {
                        text: "低噪";
                        compact: true;
                        variant: 2;
                        width: 56px;
                        enabled: !AppState.curve-apply-pending;
                        clicked => { AppState.command(33, AppState.curve-channel, 1); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FluentButton {
                        text: "性能";
                        compact: true;
                        variant: 2;
                        width: 56px;
                        enabled: !AppState.curve-apply-pending;
                        clicked => { AppState.command(33, AppState.curve-channel, 2); }
                    }
                }
            }

            if AppState.cooler-boost : InfoBar {
                level: 4;
                text: "强冷散热已开启，风扇当前由硬件全速接管，关闭后将自动恢复当前模式的风扇策略。";
            }
            if !AppState.cooler-boost && root.silent-mode : InfoBar {
                level: 4;
                text: "静音模式由主板内置静音风扇策略接管；如需使用自定义曲线，请切换至平衡、极致性能或超级省电模式。";
            }
            if !AppState.cooler-boost && !root.silent-mode && AppState.fan-mode == 0 : NoteRow {
                level: 4;
                text: AppState.current-mode-custom-saved
                    ? ("当前为主板自动调速；「" + Fmt.mode-name(AppState.performance-mode) + "」已记忆自定义曲线，点「启用」可立即恢复。")
                    : ("当前由主板按「" + Fmt.mode-name(AppState.performance-mode) + "」自动调速；调整曲线并点「应用」或「启用」可为该模式单独记忆。");
            }
            if !AppState.cooler-boost && !root.silent-mode && AppState.fan-mode == 2 : NoteRow {
                level: 3;
                glyph: "check";
                text: AppState.custom-fan-modes-summary != ""
                    ? ("已按性能模式记忆自定义曲线（" + AppState.custom-fan-modes-summary + "），切换模式时自动套用。")
                    : ("自定义曲线正在接管风扇；点击「应用」可保存至「" + Fmt.mode-name(AppState.performance-mode) + "」，或点击「恢复自动」。");
            }

            if root.wide-curves : HorizontalLayout {
                spacing: Theme.gap;
                CpuCurveCard { canvas-h: root.curve-canvas-h; }
                GpuCurveCard { canvas-h: root.curve-canvas-h; }
            }
            if !root.wide-curves : VerticalLayout {
                spacing: Theme.gap;
                CpuCurveCard { canvas-h: root.curve-canvas-h; }
                GpuCurveCard { canvas-h: root.curve-canvas-h; }
            }
        }
    }
}
