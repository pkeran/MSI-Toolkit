// Page 4: Keyboard Lighting — 1:1 physical MS-17S3 / MS-1603 24-zone keyboard
// + HSV Color Picker + native hardware lighting modes (Static / Breathing /
// ColorCycle / Wave) + Speed + Brightness + aligned quick presets.

import { Theme } from "../theme.slint";
import { AppState, Fmt } from "../state.slint";
import { ZoneMatrix } from "../components/zone_matrix.slint";
import { ColorPicker } from "../components/color_picker.slint";
import { FluentButton } from "../components/fluent_button.slint";
import { FluentSegmentBar } from "../components/fluent_segment.slint";
import { InfoBar } from "../components/info_bar.slint";
import { SectionLabel, KeyValue, Rule } from "../components/primitives.slint";

component PresetChipButton inherits Rectangle {
    in property <string> label: "";
    in property <color> dot: #FFFFFF;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 28px;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.btn-disabled
              : ta.pressed ? Theme.btn-pressed
              : ta.has-hover ? Theme.btn-hover
              : Theme.btn-bg;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.card-stroke-hover : Theme.btn-border;
    clip: true;

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Fixed-width centered box so swatches & labels align cleanly across all 2x2 cells.
    Rectangle {
        width: min(64px, max(0px, parent.width - 16px));
        height: parent.height;
        x: (parent.width - self.width) / 2;
        y: 0px;
        background: transparent;

        Rectangle {
            x: 0px;
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: root.dot;
            border-width: 1px;
            border-color: Theme.stroke-strong;
        }
        Text {
            x: 18px;
            y: 0px;
            width: max(0px, parent.width - 18px);
            height: parent.height;
            text: root.label;
            font-size: Theme.font-caption;
            color: root.enabled ? Theme.text : Theme.text-disabled;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component LightingControlsDeck inherits Rectangle {
    in property <bool> can-edit: true;

    horizontal-stretch: 2;
    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-stroke;

    VerticalLayout {
        padding: 12px;
        spacing: 7px;

        SectionLabel {
            text: "灯效模式";
            glyph: "pulse";
            hint: Fmt.effect-name(AppState.zone-effect);
        }
        FluentSegmentBar {
            compact: true;
            labels: ["常亮", "呼吸", "循环", "波浪"];
            values: [0, 1, 2, 3];
            current: AppState.zone-effect;
            enabled: root.can-edit;
            picked(v) => { AppState.command(46, v, 0); }
        }

        HorizontalLayout {
            spacing: 10px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                SectionLabel {
                    text: "速度";
                    glyph: "gauge";
                    hint: AppState.zone-effect == 0 ? "—" : Fmt.speed-name(AppState.zone-speed);
                }
                FluentSegmentBar {
                    compact: true;
                    labels: ["慢", "中", "快"];
                    values: [0, 1, 2];
                    current: AppState.zone-speed;
                    enabled: root.can-edit && AppState.zone-effect != 0;
                    picked(v) => { AppState.command(47, v, 0); }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                SectionLabel {
                    text: "亮度";
                    glyph: "lighting";
                    hint: "" + AppState.zone-brightness + " / 3";
                }
                FluentSegmentBar {
                    compact: true;
                    labels: ["关", "低", "中", "高"];
                    values: [0, 1, 2, 3];
                    current: AppState.zone-brightness;
                    enabled: root.can-edit;
                    picked(v) => { AppState.command(44, v, 0); }
                }
            }
        }

        SectionLabel { text: "快速预设"; glyph: "layers"; }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                PresetChipButton { label: "MSI 红"; dot: #FF1A1A; enabled: root.can-edit; clicked => { AppState.command(42, 0, 0); } }
                PresetChipButton { label: "冰蓝";   dot: #35C8FF; enabled: root.can-edit; clicked => { AppState.command(42, 1, 0); } }
            }
            HorizontalLayout {
                spacing: 6px;
                PresetChipButton { label: "纯白";   dot: #F2F2F2; enabled: root.can-edit; clicked => { AppState.command(42, 2, 0); } }
                PresetChipButton { label: "熄灭";   dot: #1A1A1A; enabled: root.can-edit; clicked => { AppState.command(42, 3, 0); } }
            }
        }

        Rule { }

        KeyValue {
            k: AppState.keyboard-device == "—" ? "键盘状态" : AppState.keyboard-device;
            v: AppState.keyboard-conflict ? "被 MSI 软件占用"
             : !AppState.cap-keyboard ? (AppState.connection == 1 ? "未检测到设备" : "等待连接")
             : (AppState.keyboard-submit == "" ? "就绪 · 硬件原生灯效" : AppState.keyboard-submit);
            mono: false;
            level: AppState.keyboard-conflict ? 2 : (AppState.cap-keyboard ? 3 : 0);
            row-height: 20px;
        }

        FluentButton {
            text: "应用到键盘";
            glyph: "check";
            variant: 1;
            height: 32px;
            enabled: AppState.cap-keyboard && !AppState.keyboard-conflict && AppState.interactive;
            clicked => { AppState.command(41, 0, 0); }
        }
    }
}

export component LightingPage inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;

    property <bool> wide-deck: root.width >= 720px;
    property <bool> can-edit: !AppState.keyboard-conflict && (AppState.cap-keyboard || AppState.demo);

    VerticalLayout {
        spacing: 10px;
        alignment: start;

        ZoneMatrix {
            zones: AppState.zones;
            selected: AppState.zone-selected;
            selected-count: AppState.zone-selected-count;
            enabled: root.can-edit;
            conflict: AppState.keyboard-conflict;
            toggle(i, additive) => { AppState.zone-edit(i, additive); }
            select-all() => { AppState.command(43, 1, 0); }
            select-none() => { AppState.command(43, 0, 0); }
        }

        if AppState.keyboard-conflict : InfoBar {
            level: 2;
            text: "检测到 MSI 灯效服务正在占用键盘，请前往「系统与工具」停止后再设置灯光。";
        }

        if AppState.connection == 1 && !AppState.cap-keyboard && !AppState.keyboard-conflict : InfoBar {
            level: 1;
            text: "未检测到兼容的 24 区背光键盘。若刚更新程序，请重启后台服务后再试。";
        }

        if root.wide-deck : HorizontalLayout {
            spacing: 12px;

            ColorPicker {
                horizontal-stretch: 3;
                hue: AppState.zone-hue;
                sat: AppState.zone-sat;
                val: AppState.zone-val;
                pure-hue: AppState.zone-pure-hue;
                active-color: AppState.zone-active-color;
                active-hex: AppState.zone-color-hex;
                enabled: root.can-edit;
                picked-hsv(h, s, v) => { AppState.zone-hsv(h, s, v); }
                picked-hex(hex) => { AppState.command-text(45, hex); }
            }

            LightingControlsDeck { can-edit: root.can-edit; }
        }

        if !root.wide-deck : VerticalLayout {
            spacing: 12px;

            ColorPicker {
                hue: AppState.zone-hue;
                sat: AppState.zone-sat;
                val: AppState.zone-val;
                pure-hue: AppState.zone-pure-hue;
                active-color: AppState.zone-active-color;
                active-hex: AppState.zone-color-hex;
                enabled: root.can-edit;
                picked-hsv(h, s, v) => { AppState.zone-hsv(h, s, v); }
                picked-hex(hex) => { AppState.command-text(45, hex); }
            }

            LightingControlsDeck { can-edit: root.can-edit; }
        }
    }
}
