// Win11 / Magpie borderless NavigationView item.
// Selection is signalled by subtle surface fill + primary text + external 3x16
// accent pill sliding vertically along the left edge.
// Icon sits on a fixed x=11px axis (centered inside the 40px collapsed item) so
// icons never jump horizontally during the sidebar expand/collapse animation.

import { Theme } from "../theme.slint";
import { Icon } from "../icons.slint";

export component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <string> glyph: "info";
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    in property <string> badge: "";
    callback activated();
    callback hover-changed(hovered: bool);

    height: Theme.nav-item-h;
    border-radius: Theme.radius;
    clip: true;
    background: ta.pressed ? Theme.nav-pressed
              : root.selected ? Theme.nav-selected
              : ta.has-hover ? Theme.nav-hover
              : transparent;
    animate background { duration: Theme.dur-hover; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.label;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        changed has-hover => { root.hover-changed(self.has-hover); }
    }

    // Fixed 18px icon locked to x=11px (center 20px inside 40px item -> 24px rail centerline)
    Icon {
        x: 11px;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 18px;
        tint: root.selected ? Theme.text : (ta.has-hover ? Theme.text : Theme.text-2);
    }

    // Smooth opacity + subtle 5px glide on label; fixed width prevents mid-transition wrap jitter
    Text {
        x: root.collapsed ? 35px : 41px;
        y: 0px;
        width: root.badge != "" ? 96px : 124px;
        height: parent.height;
        text: root.label;
        font-size: Theme.font-body;
        font-weight: root.selected ? 500 : 400;
        color: root.selected ? Theme.text : (ta.has-hover ? Theme.text : Theme.text-2);
        vertical-alignment: center;
        overflow: elide;
        opacity: root.collapsed ? 0.0 : 1.0;
        animate x { duration: Theme.reduced-motion ? 0ms : 165ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
        animate opacity { duration: Theme.reduced-motion ? 0ms : 130ms; easing: ease-out; }
    }

    // Expanded badge pill
    if root.badge != "" : Rectangle {
        x: 142px;
        y: (parent.height - self.height) / 2;
        height: 18px;
        width: 24px;
        border-radius: 9px;
        background: Theme.accent;
        opacity: root.collapsed ? 0.0 : 1.0;
        animate opacity { duration: Theme.reduced-motion ? 0ms : 120ms; easing: ease-out; }

        Text {
            width: parent.width;
            height: parent.height;
            text: root.badge;
            font-size: 10px;
            font-weight: 600;
            color: Theme.on-accent;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // Collapsed badge dot
    if root.badge != "" : Rectangle {
        x: 27px;
        y: 7px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Theme.accent;
        border-width: 1px;
        border-color: Theme.nav;
        opacity: root.collapsed ? 1.0 : 0.0;
        animate opacity { duration: Theme.reduced-motion ? 0ms : 120ms; easing: ease-out; }
    }
}
