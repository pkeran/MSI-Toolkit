// Floating overlay Toast with smooth fade-in / fade-out and subtle vertical glide.
// Mounted outside the page layout flow so notifications cause ZERO layout shift
// and repaint only a tiny bounding box on Slint's software renderer.

import { Theme } from "../theme.slint";
import { Icon } from "../icons.slint";

export component Toast inherits Rectangle {
    in property <bool> shown: false;
    /// 1 = warn, 2 = danger, 3 = ok, 4 = info
    in property <int> level: 4;
    in property <string> title: "";
    in property <string> text: "";
    in property <length> max-w: 380px;
    in property <length> anchor-y: 12px;
    callback dismiss();

    width: clamp(toast-row.preferred-width, 168px, max(168px, root.max-w));
    height: root.text != "" ? 46px : 38px;
    border-radius: 8px;
    background: Theme.toast-bg;
    border-width: 1px;
    border-color: root.level == 2
        ? Theme.danger.with-alpha(0.38)
        : root.level == 1
            ? Theme.warn.with-alpha(0.35)
            : Theme.toast-border;
    clip: true;

    opacity: 0.0;
    y: root.anchor-y + 10px;

    states [
        open when root.shown : {
            opacity: 1.0;
            y: root.anchor-y;
            in {
                animate opacity { duration: Theme.dur-toast-in; easing: cubic-bezier(0.0, 0.0, 0.2, 1.0); }
                animate y { duration: Theme.dur-toast-in; easing: cubic-bezier(0.0, 0.0, 0.2, 1.0); }
            }
            out {
                animate opacity { duration: Theme.dur-toast-out; easing: cubic-bezier(0.4, 0.0, 1.0, 1.0); }
                animate y { duration: Theme.dur-toast-out; easing: cubic-bezier(0.4, 0.0, 1.0, 1.0); }
            }
        }
    ]

    // Subtle top specular highlight + bottom depth rim (zero Gaussian blur cost on software renderer)
    Rectangle {
        x: 1px;
        y: 1px;
        width: max(0px, parent.width - 2px);
        height: 1px;
        background: Theme.btn-bevel-top;
    }
    Rectangle {
        x: 1px;
        y: max(0px, parent.height - 2px);
        width: max(0px, parent.width - 2px);
        height: 1px;
        background: Theme.dark ? rgba(0, 0, 0, 0.35) : rgba(0, 0, 0, 0.08);
    }

    // Semantic left accent pill
    Rectangle {
        x: 4px;
        y: 8px;
        width: 3px;
        height: max(0px, parent.height - 16px);
        border-radius: 1.5px;
        background: Theme.severity-color(root.level);
    }

    // Only accept clicks while visible; fully click-through when hidden/fading out
    if root.shown : TouchArea {
        mouse-cursor: pointer;
        clicked => { root.dismiss(); }
    }

    toast-row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 9px;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.level == 2 || root.level == 1 ? "warning"
                     : root.level == 3 ? "check"
                     : "info";
                size: 15px;
                tint: Theme.severity-icon-color(root.level);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                font-size: Theme.font-caption;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.text != "" : Text {
                text: root.text;
                font-size: Theme.font-micro;
                color: Theme.text-2;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: "×";
                font-size: 14px;
                font-weight: 500;
                color: Theme.text-3;
                vertical-alignment: center;
            }
        }
    }
}
