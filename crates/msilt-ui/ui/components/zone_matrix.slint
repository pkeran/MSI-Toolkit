        { label: "Pwr",   x: 1281.9, y:   1.1, w:  51.0, h: 37.0, zone: 10, zl: -1, zr: -1 },

        // ── Row 1: Number row (main) ──
        { label: "`",         x:    0.0, y:  50.2, w:  45.0, h: 69.0, zone: 0, zl: -1, zr: -1 },
