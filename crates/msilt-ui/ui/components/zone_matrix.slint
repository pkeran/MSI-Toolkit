        { label: "6",     x: 1281.9, y: 185.9, w:  51.0, h: 55.0, zone: 23, zl: -1, zr: -1 },
        { label: "1",     x: 1154.9, y: 253.6, w:  51.0, h: 55.0, zone: 21, zl: -1, zr: -1 },
        { label: "2",     x: 1218.3, y: 253.6, w:  51.0, h: 55.0, zone: 22, zl: -1, zr: -1 },
        { label: "3",     x: 1281.9, y: 253.6, w:  51.0, h: 55.0, zone: 23, zl: -1, zr: -1 },
        { label: "0",     x: 1154.9, y: 321.2, w: 114.4, h: 55.0, zone: 22, zl: 21, zr: -1 },
        { label: ".",     x: 1281.9, y: 321.2, w:  51.0, h: 55.0, zone: 23, zl: -1, zr: -1 },
        { label: "Enter", x: 1217.9, y: 388.9, w: 115.0, h: 55.0, zone: 23, zl: 22, zr: -1 },
    ];

    pure function zone-is-selected(i: int) -> bool {
        if i < 0 || i >= root.selected.length { return false; }
        return root.selected[i];
    }

    pure function zone-desc(z: int) -> string {
        if z == 0  { return "Esc / ` / Tab"; }
        if z == 1  { return "F1-F2 / 1-2 / Q-W"; }
        if z == 2  { return "F3-F4 / 3-4 / E-R"; }
        if z == 3  { return "F5-F6 / 5-6 / T-Y"; }
        if z == 4  { return "F7-F9 / 7-8 / U-I"; }
        if z == 5  { return "F10-F11 / 9-0 / O"; }
        if z == 6  { return "F12-PrtSc / -= / P[]"; }
        if z == 7  { return "Ins-Del / Backspace / \\"; }
        if z == 8  { return "小键盘 * / + / 7"; }
        if z == 9  { return "小键盘 / / - / 8"; }
        if z == 10 { return "电源 / NumLk / 9"; }
        if z == 11 { return "Caps / 左 Shift / 左 Ctrl"; }
        if z == 12 { return "A 键（独立灯区）"; }
        if z == 13 { return "S / Z / Win"; }
        if z == 14 { return "D / X / 左 Alt"; }
        if z == 15 { return "F / C / V / 空格左"; }
        if z == 16 { return "G-H / B-N / 空格中"; }
        if z == 17 { return "J-K / M-, / 空格右 / AltGr"; }
        if z == 18 { return "L-; / .-/ / \\ / Copilot"; }
        if z == 19 { return "' / 右 Shift / Fn / ←"; }
        if z == 20 { return "Enter / ↑ / ↓"; }
        if z == 21 { return "小键盘 4 / 1 / →"; }
        if z == 22 { return "小键盘 5 / 2 / 0"; }
        if z == 23 { return "小键盘 6 / 3 / . / Enter"; }
        return "";
    }

    background: transparent;
    horizontal-stretch: 1;

    // Responsive CAD scale factor preserving exact 1334x446 physical aspect ratio
    property <length> deck-inner-w: max(560px, root.width - 30px);
    property <float> scale: clamp(root.deck-inner-w / 1334px, 0.44, 0.62);
    property <length> board-w: 1334px * root.scale;
    property <length> board-h: 446px * root.scale;

    VerticalLayout {
        spacing: 8px;

        // Clean toolbar above keyboard with live hover region preview
        HorizontalLayout {
            spacing: 8px;
            height: 28px;

            Text {
                text: "24 区背光键盘";
                font-size: Theme.font-group;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.conflict : VerticalLayout {
                alignment: center;
                Chip {
                    text: "被 MSI 软件占用";
                    level: 2;
                }
            }
            if !root.conflict && root.hovered-zone >= 0 : VerticalLayout {
                alignment: center;
                Chip {
                    text: "第 " + (root.hovered-zone + 1) + " 区 · " + root.zone-desc(root.hovered-zone)
                        + (root.zone-is-selected(root.hovered-zone) ? "（点击取消）" : "（点击选中）");
                    level: 4;
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            VerticalLayout {
                alignment: center;
                Chip {
                    text: root.selected-count == 0
                        ? "全键盘 · 点按多选"
                        : ("已选 " + root.selected-count + " / 24 区");
                    level: root.selected-count > 0 ? 3 : 0;
                }
            }
            VerticalLayout {
                alignment: center;
                FluentButton {
                    text: "全选";
                    compact: true;
                    variant: 0;
                    width: 68px;
                    enabled: root.enabled;
                    clicked => { root.select-all(); }
                }
            }
            VerticalLayout {
                alignment: center;
                FluentButton {
                    text: "清空选区";
                    compact: true;
                    variant: 0;
                    width: 78px;
                    enabled: root.enabled && root.selected-count > 0;
                    clicked => { root.select-none(); }
                }
            }
        }

        // Matte aluminum / graphite physical keyboard chassis
        Rectangle {
            background: Theme.dark ? #26272C : #E3E6EC;
            border-radius: 10px;
            border-width: 1.5px;
            border-color: root.conflict ? Theme.danger : (Theme.dark ? #3A3C44 : #CCD1DB);
            clip: true;

            Rectangle {
                x: 0px;
                y: max(0px, parent.height - 4px);
                width: parent.width;
                height: 4px;
                background: Theme.dark ? #1B1C20 : #D1D6DF;
            }

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 7px;
                padding-bottom: 9px;
                alignment: center;

                // Inner switch well sized proportionally to exact CAD bounds
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.board-w + 10px;
                        height: root.board-h + 10px;
                        background: Theme.dark ? #1B1C20 : #CFD4DD;
                        border-radius: 6px;

                        Rectangle {
                            x: 5px;
                            y: 5px;
                            width: root.board-w;
                            height: root.board-h;
                            background: transparent;

                            for k in root.layout : PhysKey {
                                x: k.x * root.scale * 1px;
                                y: k.y * root.scale * 1px;
                                width: k.w * root.scale * 1px;
                                height: k.h * root.scale * 1px;
                                label: k.label;
                                zone: k.zone;
                                zl: k.zl;
                                zr: k.zr;
                                compact-font: k.h < 42.0;
                                zones: root.zones;
                                selected: root.selected;
                                hovered-zone: root.hovered-zone;
                                enabled: root.enabled;
                                picked(z, additive) => { root.toggle(z, additive); }
                                hover-zone(z) => { root.hovered-zone = z; }
                            }
                        }
                    }
                }
            }
        }
    }
}
