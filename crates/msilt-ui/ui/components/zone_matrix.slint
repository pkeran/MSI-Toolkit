// `ZoneMatrix` — 1:1 physical MSI Vector 17 HX AI (MS-17S3 / MS-1603) 99-key
// keyboard using exact 1334x446 CAD coordinates & official 24-zone hardware
// bit map (top Z1..Z11 = bits 0..10, bottom Z12..Z24 = bits 11..23).
//
// UX guarantees:
//   * 1:1 visual color reproduction (exact keycap RGB, smooth cross-zone LED
//     blending on wide keys Space / Enter / Num 0 / Num Enter);
//   * left-click additive multi-select, right-click exclusive select;
//   * full hardware-zone hover preview before clicking (highlights every key
//     in that zone + live toolbar preview badge).

import { Theme } from "../theme.slint";
import { FluentButton } from "fluent_button.slint";
import { Chip } from "primitives.slint";

struct KeyDef {
    label: string,
    x: float,
    y: float,
    w: float,
    h: float,
    zone: int,   // primary hardware zone bit (0..23)
    zl: int,     // optional left neighbor zone for wide straddling keys (-1 = none)
    zr: int,     // optional right neighbor zone for wide straddling keys (-1 = none)
}

component PhysKey inherits Rectangle {
    in property <string> label: "";
    in property <int> zone: 0;
    in property <int> zl: -1;
    in property <int> zr: -1;
    in property <[color]> zones: [];
    in property <[bool]> selected: [];
    in property <int> hovered-zone: -1;
    in property <bool> enabled: true;
    in property <bool> compact-font: false;
    callback picked(zone: int, additive: bool);
    callback hover-zone(zone: int);

    pure function led-color(z: int) -> color {
        if z < 0 || z >= root.zones.length {
            return Theme.dark ? #32343A : #C8CCD4;
        }
        return root.zones[z];
    }

    pure function is-black(c: color) -> bool {
        return c.red == 0 && c.green == 0 && c.blue == 0;
    }

    pure function cap-color(z: int) -> color {
        if root.is-black(root.led-color(z)) {
            return Theme.dark ? #32343A : #C8CCD4;
        }
        return root.led-color(z);
    }

    property <color> c-main: root.cap-color(root.zone);
    property <color> c-left: root.zl >= 0 ? root.cap-color(root.zl) : root.c-main;
    property <color> c-right: root.zr >= 0 ? root.cap-color(root.zr) : root.c-main;
    property <bool> has-grad3: root.zl >= 0 && root.zr >= 0 && (root.c-left != root.c-main || root.c-right != root.c-main);
    property <bool> has-grad-l: root.zl >= 0 && root.zr < 0 && root.c-left != root.c-main;
    property <bool> has-grad-r: root.zr >= 0 && root.zl < 0 && root.c-right != root.c-main;

    property <bool> is-selected: root.zone >= 0 && root.zone < root.selected.length ? root.selected[root.zone] : false;
    property <bool> is-zone-hover: root.hovered-zone >= 0 && root.hovered-zone == root.zone;
    property <float> luma: 0.299 * root.c-main.red + 0.587 * root.c-main.green + 0.114 * root.c-main.blue;

    border-radius: 4px;
    background: root.has-grad3
        ? @linear-gradient(90deg, root.c-left 15%, root.c-main 50%, root.c-right 85%)
        : root.has-grad-l
        ? @linear-gradient(90deg, root.c-left 22%, root.c-main 78%)
        : root.has-grad-r
        ? @linear-gradient(90deg, root.c-main 22%, root.c-right 78%)
        : root.c-main;
    border-width: root.is-zone-hover ? 2px : (root.is-selected ? 1.5px : 0px);
    border-color: root.is-zone-hover ? Theme.accent
                : root.is-selected ? (Theme.dark ? #F5F6F8 : #18191C)
                : transparent;
    clip: true;

    // Subtle 1px bottom physical lip ONLY (never tints the face color so RGB stays 1:1)
    Rectangle {
        x: 0px;
        y: max(0px, parent.height - 1.5px);
        width: parent.width;
        height: 1.5px;
        background: rgba(0, 0, 0, 0.22);
    }

    // Crisp hover region preview rim across every key belonging to the hovered hardware zone
    if root.is-zone-hover : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: 3px;
        background: root.luma > 165.0 ? rgba(0, 0, 0, 0.10) : rgba(255, 255, 255, 0.16);
    }

    // Corner selection indicator badge
    if root.is-selected : Rectangle {
        x: max(2px, parent.width - 8.5px);
        y: 2.5px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: #F4F5F7;
        border-width: 1.25px;
        border-color: #18191C;
    }

    Text {
        x: 1px;
        y: 0px;
        width: max(0px, parent.width - 2px);
        height: max(0px, parent.height - 1px);
        text: root.label;
        font-size: root.compact-font ? 8.5px : (root.label == "Copilot" ? (parent.width < 36px ? 7.5px : 8.5px) : (parent.width < 34px ? 9px : 10px));
        font-weight: 500;
        font-family: Theme.font-ui;
        color: root.luma > 132.0 ? #18191C : rgba(248, 249, 251, 0.94);
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    key-ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        changed has-hover => {
            if (self.has-hover) {
                root.hover-zone(root.zone);
            } else if (root.hovered-zone == root.zone) {
                root.hover-zone(-1);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.right) {
                    root.picked(root.zone, false);
                } else if (e.button == PointerEventButton.left) {
                    root.picked(root.zone, true);
                }
            }
        }
    }
}

export component ZoneMatrix inherits Rectangle {
    in property <[color]> zones: [];
    in property <[bool]> selected: [];
    in property <int> selected-count: 0;
    in property <bool> enabled: true;
    in property <bool> conflict: false;
    callback toggle(index: int, additive: bool);
    callback select-all();
    callback select-none();

    property <int> hovered-zone: -1;

    // 1:1 MSI Vector 17 HX AI (MS-17S3 / MS-1603) 99-key layout in 1334x446 CAD units
    property <[KeyDef]> layout: [
        // ── Row 0: Function bar (16 main + 3 numpad) ──
