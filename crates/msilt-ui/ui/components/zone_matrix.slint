        { label: "F9",    x:  649.4, y:   1.1, w:  60.0, h: 37.0, zone:  4, zl: -1, zr: -1 },
        { label: "F10",   x:  721.6, y:   1.1, w:  60.0, h: 37.0, zone:  5, zl: -1, zr: -1 },
