// Refined Win11 Fluent segmented selector: inset track + elevated active thumb
// with subtle 1px top specular bevel (replaces clunky checkable button rows).

import { Theme } from "../theme.slint";

export component FluentSegmentBar inherits Rectangle {
    in property <[string]> labels: [];
    in property <[int]> values: [];
    in property <int> current: -1;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback picked(value: int);

    height: root.compact ? 30px : 34px;
    horizontal-stretch: 1;
    background: Theme.segment-track;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-stroke;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for i in labels.length : Rectangle {
            property <bool> is-active: i < root.values.length && root.values[i] == root.current;
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            border-width: is-active ? 1px : 0px;
            background: is-active ? Theme.btn-bg
                      : (seg-ta.has-hover && root.enabled ? Theme.subtle-hover : transparent);
            border-color: is-active ? Theme.btn-border : transparent;
            animate background { duration: Theme.dur-hover; easing: ease-out; }
            clip: true;

            if is-active : Rectangle {
                x: 1px;
                y: 1px;
                width: max(0px, parent.width - 2px);
                height: 1px;
                background: Theme.btn-bevel-top;
            }

            if is-active : Rectangle {
                x: 1px;
                y: max(0px, parent.height - 2px);
                width: max(0px, parent.width - 2px);
                height: 1px;
                background: Theme.btn-bevel-bottom;
            }

            // Subtle accent underline on active segment
            if is-active && root.enabled : Rectangle {
                x: (parent.width - min(20px, max(10px, parent.width * 0.36))) / 2;
                y: parent.height - 2.5px;
                width: min(20px, max(10px, parent.width * 0.36));
                height: 2px;
                border-radius: 1px;
                background: Theme.accent;
            }

            seg-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    if i < root.values.length {
                        root.picked(root.values[i]);
                    }
                }
            }

            Text {
                text: root.labels[i];
                font-size: Theme.font-caption;
                font-weight: is-active ? 600 : 400;
                color: !root.enabled ? Theme.text-disabled
                     : is-active ? Theme.text
                     : Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
