// `StatusPill` — sleek Win11 topbar status capsule with optional click interaction.
// level: 0 neutral · 1 warn · 2 danger · 3 ok · 4 accent

import { Theme } from "../theme.slint";
import { Icon } from "../icons.slint";

export component StatusPill inherits Rectangle {
    in property <string> glyph: "";
    in property <string> label: "";
    in property <string> value: "";
    in property <int> level: 0;
    in property <bool> clickable: false;
    callback clicked();

    height: Theme.pill-h;
    border-radius: Theme.radius;
    background: root.clickable && ta.pressed ? Theme.subtle-pressed
              : root.clickable && ta.has-hover ? Theme.subtle-hover
              : transparent;
    border-width: 0px;
    width: pill-layout.preferred-width;

    ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => {
            if root.clickable {
                root.clicked();
            }
        }
    }

    pill-layout := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;

        if root.level != 0 : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.severity-color(root.level);
            }
        }
        if root.level == 0 && root.glyph != "" : VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 13px;
                tint: Theme.text-3;
            }
        }
        if root.label != "" : Text {
            text: root.label;
            font-size: Theme.font-micro;
            color: Theme.text-3;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            font-size: Theme.font-caption;
            font-weight: 500;
            font-family: Theme.font-mono;
            color: root.level == 2 || root.level == 1 ? Theme.text : Theme.text-2;
            vertical-alignment: center;
        }
    }
}
