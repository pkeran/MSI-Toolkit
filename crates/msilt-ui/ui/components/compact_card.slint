// Magpie-aligned compact horizontal control card for dashboard grids (68px high).

import { Theme } from "../theme.slint";
import { Icon } from "../icons.slint";

export component CompactCard inherits Rectangle {
    in property <string> glyph: "info";
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <color> accent-border: transparent;

    height: 68px;
    horizontal-stretch: 1;
    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.accent-border != transparent ? root.accent-border : Theme.card-stroke;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 20px;
                tint: Theme.text-2;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: Theme.font-card-title;
                font-weight: 400;
                color: Theme.text;
                overflow: elide;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: Theme.font-caption;
                color: Theme.text-2;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                @children
            }
        }
    }
}
