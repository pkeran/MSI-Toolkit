// Magpie KeyVisual-inspired keyboard keycap badge (4px corners + subtle 2px rim).

import { Theme } from "../theme.slint";

export component KeyChip inherits Rectangle {
    in property <string> label: "";

    height: 24px;
    width: max(28px, key-layout.preferred-width);
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: Theme.btn-bg;
    border-width: 1px;
    border-color: Theme.btn-border;
    clip: true;

    Rectangle {
        x: 1px;
        y: 1px;
        width: max(0px, parent.width - 2px);
        height: 1px;
        background: Theme.btn-bevel-top;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: Theme.dark ? rgba(0, 0, 0, 0.32) : rgba(0, 0, 0, 0.14);
    }

    key-layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 1px;
        Text {
            text: root.label;
            font-size: Theme.font-micro;
            font-weight: 600;
            font-family: Theme.font-mono;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
