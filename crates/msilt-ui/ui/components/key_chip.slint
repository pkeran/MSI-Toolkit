// Flat Magpie-style keyboard keycap badge (zero 3D bevels or drop rims).

import { Theme } from "../theme.slint";

export component KeyChip inherits Rectangle {
    in property <string> label: "";

    height: 24px;
    width: max(28px, key-layout.preferred-width);
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: Theme.btn-bg;
    border-width: 1px;
    border-color: Theme.btn-border;
    clip: true;

    key-layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: Theme.font-micro;
            font-weight: 600;
            font-family: Theme.font-mono;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
